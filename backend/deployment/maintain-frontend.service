[Unit]
Description=mAIntAIn FastAPI Backend
After=network.target

[Service]

User=root
WorkingDirectory=/root/Qwen-Hackathon/backend

ExecStart=/root/Qwen-Hackathon/backend/.venv/bin/uvicorn \
main:app \
--host 127.0.0.1 \
--port 8000

Restart=always

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
